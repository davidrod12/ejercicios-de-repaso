/* ================================
   ESTILOS GENERALES
   ================================ */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f2f2f2;
    color: #333;
    padding: 40px 20px;
}

/* Título principal */
h1 {
    text-align: center;
    margin-bottom: 15px;
    color: #222;
}

.descripcion {
    text-align: center;
    margin-bottom: 35px;
    color: #666;
}

/* ================================
   EJERCICIO 1
   FLEXBOX - 3 TARJETAS EN FILA
   ================================ */

.contenedor-tarjetas {
    /* Activamos Flexbox */
    display: flex;
    /* Colocamos las tarjetas en una fila */
    flex-direction: row;
    /* Espacio entre las tarjetas */
    gap: 20px;
    /* Centramos las tarjetas */
    justify-content: center;
    /* Permitimos que se ajusten */
    flex-wrap: wrap;
    /* Ancho máximo */
    max-width: 1100px;
    /* Centramos el contenedor */
    margin: 0 auto;
}

/* ================================
   EJERCICIO 3
   BOX MODEL + SOMBRA
   ================================ */

.tarjeta {
    /* Cada tarjeta ocupa aproximadamente un tercio del contenedor */
    flex: 1;
    min-width: 250px;
    /* BOX MODEL - PADDING */
    padding: 30px;
    /* BOX MODEL - MARGIN */
    margin: 10px;
    /* BOX MODEL - BORDER */
    border: 3px solid #333;
    /* Bordes redondeados */
    border-radius: 12px;
    /* Sombra para dar profundidad */
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.20);
    /* Altura mínima */
    min-height: 220px;
    /* Transición */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Efecto cuando pasamos el mouse */
.tarjeta:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.30);
}

/* Títulos de las tarjetas */
.tarjeta h2 {
    margin-bottom: 15px;
    font-size: 24px;
}

/* Descripción */
.tarjeta p {
    line-height: 1.6;
    font-size: 16px;
}

/* ================================
   COLORES DIFERENTES
   ================================ */

.tarjeta-1 {
    background-color: #dbeafe;
    border-color: #2563eb;
}

.tarjeta-2 {
    background-color: #dcfce7;
    border-color: #16a34a;
}

.tarjeta-3 {
    background-color: #fef3c7;
    border-color: #d97706;
}

/* ================================
   EJERCICIO 2
   MEDIA QUERY
   
   En pantallas menores a 768px
   las tarjetas se apilan verticalmente.
   ================================ */

@media (max-width: 767px) {
    .contenedor-tarjetas {
        /* Cambiamos Flexbox de fila a columna */
        flex-direction: column;
        /* Ocupamos todo el ancho */
        width: 100%;
    }

    .tarjeta {
        /* Cada tarjeta ocupa el 100% */
        width: 100%;
        /* Evitamos problemas de tamaño */
        flex: none;
        /* Margen vertical */
        margin: 10px 0;
    }
}

/* ================================
   AJUSTES PARA CELULARES PEQUEÑOS
   ================================ */

@media (max-width: 480px) {
    body {
        padding: 25px 15px;
    }

    h1 {
        font-size: 28px;
    }

    .tarjeta {
        padding: 25px;
    }

    .tarjeta h2 {
        font-size: 21px;
    }
}