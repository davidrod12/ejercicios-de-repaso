/* =====================================================
   PORTAFOLIO PERSONAL - OSCAR DAVID
   CSS3 + BOX MODEL + FLEXBOX + GRID + RESPONSIVE
   ===================================================== */


/* =====================================================
   RESET
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: #172033;
    background: #ffffff;
}


a {
    text-decoration: none;
    color: inherit;
}


ul {
    list-style: none;
}


/* Contenedor general */

.container {
    width: min(1100px, 92%);
    margin: 0 auto;
}


/* =====================================================
   HEADER
   ===================================================== */

.header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(255, 255, 255, 0.96);

    border-bottom: 1px solid #e6eaf0;
}


/* FLEXBOX */

.navbar {
    min-height: 72px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 25px;
}


/* Logo */

.logo {
    font-size: 2rem;
    font-weight: 800;
    color: #172033;
}


.logo span {
    color: #1597e5;
}


/* Menú */

.nav-links {

    display: flex;

    align-items: center;

    gap: 28px;
}


.nav-links a {

    font-size: 0.95rem;

    font-weight: 600;

    color: #526074;

    transition: color 0.2s ease;
}


.nav-links a:hover {

    color: #1597e5;
}


/* =====================================================
   ELEMENTOS GENERALES
   ===================================================== */

.eyebrow {

    color: #1597e5;

    font-size: 0.8rem;

    font-weight: 800;

    letter-spacing: 2px;

    margin-bottom: 10px;
}


.section {

    padding: 90px 0;
}


.section-alt {

    background: #f5f8fb;
}


.section-heading {

    margin-bottom: 38px;
}


.section-heading h2 {

    font-size: clamp(2rem, 5vw, 2.8rem);

    line-height: 1.1;
}


/* =====================================================
   HERO
   ===================================================== */

.hero {

    min-height: calc(100vh - 72px);

    display: flex;

    align-items: center;

    background: linear-gradient(
        135deg,
        #f8fbff 0%,
        #edf6fd 100%
    );

    padding: 70px 0;
}


/* CSS GRID */

.hero-content {

    display: grid;

    grid-template-columns: 1.1fr 0.9fr;

    align-items: center;

    gap: 60px;
}


.hero-text h1 {

    font-size: clamp(2.7rem, 7vw, 5rem);

    line-height: 1.05;

    margin-bottom: 25px;
}


.hero-text h1 span {

    color: #1597e5;
}


.hero-description {

    max-width: 620px;

    color: #5c687b;

    font-size: 1.1rem;

    margin-bottom: 30px;
}


/* Botones */

.hero-buttons {

    display: flex;

    flex-wrap: wrap;

    gap: 14px;
}


.btn {

    display: inline-block;

    padding: 13px 22px;

    border-radius: 9px;

    border: 2px solid transparent;

    font-weight: 700;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.btn:hover {

    transform: translateY(-2px);
}


.btn-primary {

    color: white;

    background: #1597e5;

    box-shadow:
        0 8px 20px
        rgba(21, 151, 229, 0.2);
}


.btn-secondary {

    color: #172033;

    background: white;

    border-color: #d8e0e8;
}


/* Ventana de código */

.hero-card {

    display: flex;

    justify-content: center;
}


.code-window {

    width: 100%;

    max-width: 480px;

    padding: 25px;

    border: 1px solid #dbe5ee;

    border-radius: 18px;

    background: #172033;

    box-shadow:
        0 25px 50px
        rgba(23, 32, 51, 0.18);

    overflow: hidden;
}


.window-dots {

    display: flex;

    gap: 7px;

    margin-bottom: 22px;
}


.window-dots span {

    width: 11px;

    height: 11px;

    border-radius: 50%;

    background: #8fa0b5;
}


.code-window pre {

    white-space: pre-wrap;

    overflow-x: auto;
}


.code-window code {

    color: #dce9f5;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: 0.9rem;
}


/* =====================================================
   SOBRE MÍ
   ===================================================== */

.about-card {

    display: flex;

    align-items: flex-start;

    gap: 25px;

    padding: 32px;

    border: 1px solid #e3e8ee;

    border-radius: 16px;

    background: white;

    box-shadow:
        0 10px 30px
        rgba(23, 32, 51, 0.06);
}


.about-icon {

    min-width: 60px;

    height: 60px;

    display: grid;

    place-items: center;

    border-radius: 12px;

    background: #e8f5fd;

    font-size: 1.7rem;
}


.about-card h3 {

    margin-bottom: 8px;

    font-size: 1.35rem;
}


.about-card p {

    color: #657184;
}


/* =====================================================
   HABILIDADES
   ===================================================== */


/* CSS GRID */

.skills-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}


.skill-card {

    padding: 28px;

    border: 1px solid #e1e7ee;

    border-radius: 14px;

    background: white;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.skill-card:hover {

    transform: translateY(-5px);

    box-shadow:
        0 15px 30px
        rgba(23, 32, 51, 0.1);
}


.skill-icon {

    font-size: 2rem;

    margin-bottom: 18px;
}


.skill-card h3 {

    margin-bottom: 8px;
}


.skill-card p {

    color: #697587;

    font-size: 0.95rem;
}


/* =====================================================
   PROYECTOS
   ===================================================== */


/* CSS GRID */

.projects-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 22px;
}


.project-card {

    min-height: 330px;

    padding: 28px;

    border: 1px solid #e2e8ef;

    border-radius: 16px;

    background: white;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    box-shadow:
        0 8px 25px
        rgba(23, 32, 51, 0.05);
}


.project-number {

    color: #1597e5;

    font-size: 0.85rem;

    font-weight: 800;
}


.project-content h3 {

    font-size: 1.4rem;

    margin-bottom: 12px;
}


.project-content p {

    color: #687587;

    margin-bottom: 20px;
}


/* Etiquetas */

.tags {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;
}


.tags span {

    padding: 6px 10px;

    border-radius: 20px;

    background: #edf6fc;

    color: #177db7;

    font-size: 0.75rem;

    font-weight: 700;
}


/* =====================================================
   CONTACTO
   ===================================================== */

.contact-section {

    padding-top: 40px;
}


.contact-box {

    padding: 50px;

    border-radius: 20px;

    background: #172033;

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 35px;
}


.contact-box h2 {

    font-size:
        clamp(1.8rem, 4vw, 2.6rem);

    margin-bottom: 10px;
}


.contact-box p:not(.eyebrow) {

    max-width: 650px;

    color: #b7c4d5;
}


.contact-box .btn {

    flex-shrink: 0;
}


/* =====================================================
   FOOTER
   ===================================================== */

.footer {

    padding: 25px 0;

    border-top: 1px solid #e6eaf0;

    background: white;
}


.footer-content {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;
}


.footer p,
.footer a {

    color: #697587;

    font-size: 0.9rem;
}


.footer a:hover {

    color: #1597e5;
}


/* =====================================================
   RESPONSIVE - TABLET
   ===================================================== */

@media (max-width: 900px) {

    .hero-content {

        grid-template-columns: 1fr;

        gap: 45px;
    }


    .hero {

        min-height: auto;
    }


    .hero-card {

        justify-content: flex-start;
    }


    .skills-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .projects-grid {

        grid-template-columns: 1fr;
    }
}


/* =====================================================
   RESPONSIVE - CELULAR
   ===================================================== */

@media (max-width: 650px) {

    .navbar {

        min-height: auto;

        padding: 18px 0;

        flex-direction: column;
    }


    .nav-links {

        width: 100%;

        justify-content: center;

        flex-wrap: wrap;

        gap: 12px 18px;
    }


    .hero {

        padding: 55px 0;
    }


    .hero-text h1 {

        font-size: 2.8rem;
    }


    .section {

        padding: 65px 0;
    }


    .skills-grid {

        grid-template-columns: 1fr;
    }


    .about-card {

        flex-direction: column;

        padding: 25px;
    }


    .contact-box {

        padding: 32px 25px;

        flex-direction: column;

        align-items: flex-start;
    }


    .footer-content {

        flex-direction: column;

        text-align: center;
    }
}